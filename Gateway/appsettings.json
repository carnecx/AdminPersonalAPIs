{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "puestos-route": {
        "ClusterId": "puestos-cluster",
        "Match": {
          "Path": "/api/puestos/{**catch-all}"
        }
      },

      "oferentes-route": {
        "ClusterId": "oferentes-cluster",
        "Match": {
          "Path": "/api/oferentes/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5051"
          }
        }
      },

      "puestos-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5021"
          }
        }
      },

      "oferentes-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5122"
          }
        }
      }
    }
  }
}